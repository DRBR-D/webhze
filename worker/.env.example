# Copy file nay thanh worker/.env roi dien thong tin cua ban
# Khi da up web len Render, doi SERVER_URL thanh https://ten-app.onrender.com
SERVER_URL=http://127.0.0.1:4321

# Phai trung khop voi bien moi truong WORKER_TOKEN tren Render!
WORKER_TOKEN=change-me-to-a-strong-secret

# Google Gemini API key (tu AI Studio / Google Cloud)
GEMINI_API_KEY=your-gemini-api-key-here

# Model Gemini uu tien (worker tu dong cascade qua gemini-3.8-flash -> gemini-3.5-flash-lite -> gemma-4-31b-it -> gemini-2.5-flash)
GEMINI_MODEL=gemini-4-hydrogen

# Gioi han kich thuoc inpaint LaMa cho RTX 3050 Mobile 4GB VRAM
INPAINT_MAX_SIZE=1024
DEVICE=cuda
