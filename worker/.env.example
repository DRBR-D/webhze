# Copy file nay thanh worker/.env roi dien thong tin cua ban
SERVER_URL=https://ten-app.onrender.com

# Phai trung khop voi bien moi truong WORKER_TOKEN tren Render!
WORKER_TOKEN=change-me-to-a-strong-secret

# DeepSeek Flash API
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-flash

# Gioi han kich thuoc inpaint LaMa cho RTX 3050 Mobile 4GB VRAM (768px ~0.78s)
INPAINT_MAX_SIZE=768
DEVICE=cuda
