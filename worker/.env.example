# Copy file nay thanh worker/.env roi dien thong tin cua ban
# Khi da up web len Render, doi SERVER_URL thanh https://ten-app.onrender.com
SERVER_URL=http://127.0.0.1:4321

# Phai trung khop voi bien moi truong WORKER_TOKEN tren Render!
WORKER_TOKEN=change-me-to-a-strong-secret

# DeepSeek V4.1 API (uu tien truoc Gemini neu co key)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-flash

# Google Gemini API key (tu AI Studio / Google Cloud)
GEMINI_API_KEY=your-gemini-api-key-here

# Model Gemini uu tien (gemini-2.5-flash tat thinking nhanh nhat ~1.3s/trang; tu dong cascade qua 3.5/3.8/4)
GEMINI_MODEL=gemini-2.5-flash

# Gioi han kich thuoc inpaint LaMa cho RTX 3050 Mobile 4GB VRAM (768px ~0.78s)
INPAINT_MAX_SIZE=768
DEVICE=cuda
